{
  "name": "@coettools/ctframework",
  "version": "0.2.0",
  "description": "Lightweight raw JavaScript frontend framework for coettools apps.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/Index.js",
  "module": "./dist/Index.js",
  "browser": "./dist/ctframework.bundle.min.js",
  "exports": {
    ".": {
      "import": "./dist/Index.js",
      "default": "./dist/Index.js"
    },
    "./bundle": {
      "import": "./dist/ctframework.bundle.min.js",
      "default": "./dist/ctframework.bundle.min.js"
    },
    "./bundle/debug": {
      "import": "./dist/ctframework.bundle.js",
      "default": "./dist/ctframework.bundle.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "scripts": {
    "build": "node scripts/Build.js",
    "build:min": "node scripts/Build.js",
    "clean": "node scripts/Build.js --clean",
    "test": "node --test",
    "test:browser": "node scripts/ServeTests.js",
    "test:coverage": "node scripts/CheckShowcaseCoverage.js",
    "test:wiki": "node scripts/CheckWikiCoverage.js",
    "check:workspace": "npm run check && npm run test:wiki",
    "check": "npm run build && npm run test && npm run test:coverage",
    "package:check": "npm pack --dry-run",
    "setup:git-hooks": "node scripts/SetupGitHooks.js",
    "sync:projects": "node scripts/SyncProjects.js --committed",
    "sync:projects:preview": "node scripts/SyncProjects.js --working-tree",
    "projects:check": "npm run build && node scripts/SyncProjects.js --verify",
    "prepare": "npm run build && npm run setup:git-hooks"
  }
}
